APP_NAME="Registro de invitados"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Base de datos. Por defecto SQLite (archivo database/database.sqlite), sin configurar nada.
DB_CONNECTION=sqlite
# Para usar MySQL de Laragon: pon DB_CONNECTION=mysql, crea la base "registro_invitados" y descomenta:
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=registro_invitados
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=480
CACHE_STORE=file
LOG_LEVEL=debug

# Acceso de administrador (cámbialo)
ADMIN_PASSWORD=admin1234

